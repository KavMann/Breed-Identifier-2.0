GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=true

# Optional: force CPU inference even when CUDA is available.
# DOGBREED_DEVICE=cpu

# Optional: average original + horizontal-flip predictions.
# DOGBREED_TTA=true

# Optional: reject images that do not look like dogs.
# DOGBREED_DOG_REJECTION=true
# DOGBREED_DOG_THRESHOLD=0.25

# Optional: generate Grad-CAM heatmap overlays.
# DOGBREED_GRADCAM=true
